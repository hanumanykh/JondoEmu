{
  // Paliers 200-300 (docs/stasis-gameplay-spec.md §8, §11), read by Managers/Stasis/Tiers.cs.
  // Every Stasis dungeon has its 3.6 client counterpart (datos/dungeons.json id, Spanish client
  // name) except «Caverne de Cire Momore», which this client does not have: its tier-300 slot is
  // the Bastión de los Martilloseco (141), the newest real keyed dungeon not used elsewhere.
  "gateFromLevel": 200,
  "tiers": [
    { "level": 200, "dungeons": [ 69, 68, 67, 70, 73, 76 ] },
    // Mizz Frizz, Klim, Sylargh, Nileza, Merkator, Rey Nidas
    { "level": 225, "dungeons": [ 97, 95, 98, 99, 110, 83 ] },
    // Capitán Meno, Miauvizor (Chalœil), Kutulú, Dientinea, Rey Dazahk, Corte Tenebrosa
    { "level": 250, "dungeons": [ 103, 106, 107, 133, 134, 114, 164 ] },
    // Tal Kasha, Kuatropatas, Ilyzaelle, Orukam, Imagiro, Torkelonia, Venerable
    { "level": 275, "dungeons": [ 71, 84, 117, 119, 120, 87, 118 ] },
    // Conde Kontatrás (Harebourg), Ballena, Árbol de Muerte, Balanza, Trono de Sangre, Vórtex, Tiranía
    { "level": 300, "dungeons": [ 108, 109, 121, 135, 136, 140, 111, 141, 165 ] }
    // Bethel, Solar, Selocalipsis, Kabaal, Aurora Púrpura, Maleficios, Dios Kao, Martilloseco (for Cire Momore), Despedazadora
  ],
  // The Evolution asks for the 9 tier-300 dungeons since the last Ascension. Hardcore is only open
  // to evolved characters, so asking for them in hardcore would make the Evolution unreachable.
  "evolutionNeedsHardcore": false,
  "hardcore": { "life": 3, "damage": 2.25, "drop": 2 },
  // «Aucune clé ne drope»: every item a dungeon door asks for (the keyring excepted) is taken out
  // of fight loot. Item ids listed in keyDropExceptions still drop.
  "keysNeverDrop": true,
  "keyDropExceptions": [],
