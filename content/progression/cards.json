{
  // Les cartes de monstres (docs/stasis-gameplay-spec.md §14) : un classeur par compte, une carte
  // par monstre, une famille par race de monstre. Cartes et paquets sont virtuels (aucun objet client).
  "cardsPerPack": 5,
  // Chance qu'un combat gagné donne un paquet.
  "packDropChance": 0.03,
  // Les cartes d'un paquet : monstres de niveau paquet ± levelBand (sinon n'importe lequel).
  "levelBand": 15,
  // Achat d'un paquet au Gardien de la Fissure : en jetons Event.
  "packTokens": 5,
  // Rachat d'un doublon, en orbes (kamas-équivalent, convertis par OrbePrice) : base + par niveau du monstre.
  "sellBaseOrbes": 50,
  "sellPerLevelOrbes": 10,
  // Une famille n'entre au classeur que si elle compte au moins minFamilySize monstres
  // (les races d'un seul monstre ne feraient qu'un bonus gratuit), au plus maxFamilySize.
  "minFamilySize": 3,
  "maxFamilySize": 40,
  // Le bonus permanent d'une famille complète, pour tous les personnages du compte :
  // tiré dans cette liste par le numéro de la race (race modulo la taille de la liste).
  "familyBonuses": [
    { "stat": "vitalite", "value": 20 },
    { "stat": "sagesse", "value": 5 },
    { "stat": "prospection", "value": 5 },
    { "stat": "initiative", "value": 50 },
    { "stat": "force", "value": 5 },
    { "stat": "intelligence", "value": 5 },
    { "stat": "chance", "value": 5 },
    { "stat": "agilite", "value": 5 },
    { "stat": "pods", "value": 50 },
    { "stat": "tacle", "value": 2 },
    { "stat": "fuite", "value": 2 },
    { "stat": "soins", "value": 2 }
  ],
  // Rareté d'une carte selon le niveau de son monstre : Commune, Rare, Épique, Légendaire (niveau minimum).
  "rarityMinLevels": [1, 60, 120, 180],
  // Raffineur de cartes (§14) : .cartes raffiner <carte> <n>, mise de 1 à refinerMaxCards doublons d'une carte
  // pour une carte de la rareté suivante (de sa famille si possible) ; échec = lot perdu.
  // Chance = plafond × min(1, valeur du lot / (refinerMaxCards × prix de rachat au niveau minimum de la rareté visée)).
  "refinerMaxCards": 10,
  // Plafonds en % pour viser Rare, Épique, Légendaire.
  "refinerCaps": [75, 45, 25]
}
