{
  // Orbes de Stasis = Jondo Coins (item 20440) when PayInCoins is true: every won fight drops
  // (curve below) / KamasPerCoin coins, and fusion, Raffineur, counter, Fissure keys and rewards,
  // don rerolls are paid in coins at the same rate. Kamas stay for marketplaces, NPCs and bots,
  // and fights pay the old 10 + 5 x level kamas. PayInCoins false = Orbes are kamas again.
  // The curve (Managers/Economy/Orbes.cs), per beaten monster:
  //   Flat + PerLevel * level^Exponent, a dungeon boss x BossFactor.
  // A monster counts at most at (character level + CarryTolerance); more than OverLevelTolerance
  // levels above the strongest monster costs OverLevelPenaltyPerLevel per level, down to OverLevelFloor.
  // Archmonster in the group: x ArchmonsterFactor; tide zone: x TideFactor. Each winner gets a full share.
  // Calibration (4 monsters of his level, 40 fights/h): lvl 50 ~39k/h, lvl 150 ~196k/h, lvl 200 ~300k/h.
  "Enabled": true,
  "Flat": 10,
  "PerLevel": 0.66,
  "Exponent": 1.5,
  "BossFactor": 5,
  "ArchmonsterFactor": 5,
  "TideFactor": 2,
  "CarryTolerance": 20,
  "OverLevelTolerance": 30,
  "OverLevelPenaltyPerLevel": 0.01,
  "OverLevelFloor": 0.25,
  "PayInCoins": true,
  "KamasPerCoin": 150,
  "CoinGainFactor": 2.5
}
