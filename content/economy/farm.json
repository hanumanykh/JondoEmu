{
  // The Stasis-like farming loop (Managers/Economy): zone gauge, zone counter, tides, archmonsters.
  "Gauge": {
    "Enabled": true,
    // Base threshold = Base + PerLevel * zone level; then x Steps[completions] (last step repeats).
    "Base": 40,
    "PerLevel": 0.6,
    "Steps": [ 1.0, 1.5, 2.0 ],
    "ResetHours": 72,
    "ArchmonsterFactor": 2,
    "TideFactor": 2,
    "BuffFactor": 2
  },
  "Counter": {
    "Enabled": true,
    "DurationMinutes": 30,
    // Densité price = max(Minimum, PerLevel * zone level^Exponent); Étude x StudyFactor; Jauge x GaugeFactor.
    "PerLevel": 10,
    "Exponent": 1.5,
    "Minimum": 500,
    "StudyFactor": 0.75,
    "GaugeFactor": 2,
    "DensityDropPercent": 100,
    "StudyExperiencePercent": 50,
    // Recrue: a ghost ally at RecruitProspecting PP drops for the player (his loot roll gets +100 PP); price = Densité x RecruitFactor; exclusive with Densité.
    "RecruitProspecting": 100,
    "RecruitFactor": 0.6
  },
  "Tides": {
    "Enabled": true,
    "OnMinutes": 50,
    "OffMinutes": 10,
    "ExperiencePercent": 250,
    "LevelTolerance": 20,
    "Global": false,
    "MinimumRoster": 3,
    "Bands": [
      { "Min": 1, "Max": 50 }, { "Min": 51, "Max": 100 }, { "Min": 101, "Max": 150 },
      { "Min": 151, "Max": 200 }, { "Min": 201, "Max": 250 }, { "Min": 251, "Max": 300 }
    ]
  },
  "Archmonsters": {
    "DropPercent": 400,
    "RespawnMinMinutes": 60,
    "RespawnMaxMinutes": 180,
    // Training zones (spec §4/§22): archmonsters not unique and back in a few minutes.
    // Astrub (area 18): 30 Tainela, 95 city, 96 quarry, 97 forest, 98 fields, 99 underground, 100 sewers, 102 cemetery, 173 meadows, 335 coves; Madrestam: 1 port.
    "TrainingSubAreas": [ 1, 30, 95, 96, 97, 98, 99, 100, 102, 173, 335 ],
    "TrainingRespawnMinMinutes": 2,
    "TrainingRespawnMaxMinutes": 5
  }
}
